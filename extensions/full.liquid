{% assign cal = google_calendar_455841 %}
{% assign events = cal.events %}
{% assign calendar_names = cal.calendar_names %}
{% assign hide_prefix_for = "Week Numbers,Holidays in France" | split: "," %}

{% assign today_iso = cal.today_in_tz | default: 'now' | date: '%Y-%m-%d' %}
{% assign year = today_iso | date: '%Y' %}
{% assign month = today_iso | date: '%m' %}
{% assign today_label = today_iso | date: '%A, %-d %B %Y' %}
{% assign today_day = today_iso | date: '%d' | plus: 0 %}
{% assign first_of_month = year | append: '-' | append: month | append: '-01' %}
{% assign first_wday = first_of_month | date: '%w' | plus: 0 %}
{% assign week_start = cal.first_day | default: 0 | plus: 0 %}
{% assign lead = first_wday | minus: week_start %}
{% if lead < 0 %}{% assign lead = lead | plus: 7 %}{% endif %}

{% assign days_in_month = 31 %}
{% if month == '04' or month == '06' or month == '09' or month == '11' %}
  {% assign days_in_month = 30 %}
{% elsif month == '02' %}
  {% assign y = year | plus: 0 %}
  {% assign leap = y | modulo: 4 %}
  {% if leap == 0 %}{% assign days_in_month = 29 %}{% else %}{% assign days_in_month = 28 %}{% endif %}
{% endif %}

{% assign next_month_n = month | plus: 0 | plus: 1 %}
{% assign next_year_n = year | plus: 0 %}
{% if next_month_n > 12 %}
  {% assign next_month_n = 1 %}
  {% assign next_year_n = next_year_n | plus: 1 %}
{% endif %}
{% assign next_month = next_month_n | prepend: '00' | slice: -2, 2 %}
{% assign next_year = next_year_n | append: '' %}

{% assign days_in_next_month = 31 %}
{% if next_month == '04' or next_month == '06' or next_month == '09' or next_month == '11' %}
  {% assign days_in_next_month = 30 %}
{% elsif next_month == '02' %}
  {% assign ny = next_year_n %}
  {% assign leapn = ny | modulo: 4 %}
  {% if leapn == 0 %}{% assign days_in_next_month = 29 %}{% else %}{% assign days_in_next_month = 28 %}{% endif %}
{% endif %}

{% assign weekday_labels = 'Sun,Mon,Tue,Wed,Thu,Fri,Sat' | split: ',' %}
{% if week_start == 1 %}
  {% assign weekday_labels = 'Mon,Tue,Wed,Thu,Fri,Sat,Sun' | split: ',' %}
{% endif %}

{% assign first_week_last = 7 | minus: lead %}
{% assign weeks_shown = 0 %}
{% assign next_month_cursor = 1 %}

<div class="layout layout--col lg:layout--col">
  <div class="month-grid">
    <div class="month-weekdays bg--gray-70 2bit:bg--gray-65 1bit:bg--black">
      {% for label in weekday_labels %}
        {% assign is_weekend_label = false %}
        {% if week_start == 0 %}
          {% if forloop.first or forloop.last %}{% assign is_weekend_label = true %}{% endif %}
        {% else %}
          {% if forloop.index0 == 5 or forloop.last %}{% assign is_weekend_label = true %}{% endif %}
        {% endif %}
        <div class="month-weekday 1bit:text--white 1bit:text-stroke 1bit:text-stroke--small 1bit:text-stroke--black{% if is_weekend_label %} month-weekday--weekend bg--gray-75 2bit:bg--gray-70{% endif %}">{{ label }}</div>
      {% endfor %}
    </div>

    <div class="month-days">
      {% if first_week_last >= today_day %}
        {% assign weeks_shown = weeks_shown | plus: 1 %}
        {% for i in (1..lead) %}
          {% assign col = i | minus: 1 %}
          {% assign cell_wday = week_start | plus: col | modulo: 7 %}
          {% assign is_weekend = false %}
          {% if cell_wday == 0 or cell_wday == 6 %}{% assign is_weekend = true %}{% endif %}
          <div class="month-day month-day--empty{% if is_weekend %} month-day--weekend bg--gray-75 2bit:bg--gray-70{% endif %}"></div>
        {% endfor %}
        {% for day_num in (1..first_week_last) %}
          {% assign dd = day_num | prepend: '00' | slice: -2, 2 %}
          {% assign day_iso = year | append: '-' | append: month | append: '-' | append: dd %}
          {% assign is_today = false %}
          {% assign is_past = false %}
          {% assign is_weekend = false %}
          {% assign day_wday = day_iso | date: '%w' | plus: 0 %}
          {% if day_iso == today_iso %}{% assign is_today = true %}{% endif %}
          {% if day_iso < today_iso %}{% assign is_past = true %}{% endif %}
          {% if day_wday == 0 or day_wday == 6 %}{% assign is_weekend = true %}{% endif %}
          <div class="month-day{% if is_today %} month-day--today{% endif %}{% if is_weekend %} month-day--weekend bg--gray-75 2bit:bg--gray-70{% endif %}">
            <div class="month-day-num text--gray-50 1bit:text--black"><span class="{% if is_today %}bg--black text--white{% endif %}">{{ day_num }}</span></div>
            {% unless is_past %}
              <div class="month-day-events">
                {% for event in events %}
                  {% assign ev_start = event.start_full | default: event.date_time | date: '%Y-%m-%d' %}
                  {% assign ev_end = event.end_full | default: event.date_time | date: '%Y-%m-%d' %}
                  {% assign show_event = false %}
                  {% if event.all_day %}
                    {% if ev_end > ev_start %}
                      {% if ev_start <= day_iso and day_iso < ev_end %}{% assign show_event = true %}{% endif %}
                    {% elsif ev_start == day_iso %}
                      {% assign show_event = true %}
                    {% endif %}
                  {% else %}
                    {% if ev_start <= day_iso and ev_end >= day_iso %}{% assign show_event = true %}{% endif %}
                  {% endif %}
                  {% if show_event %}
                    {% assign display_name = '' %}
                    {% for pair in calendar_names %}
                      {% if pair[0] == event.calname %}
                        {% assign display_name = pair[1] %}
                      {% endif %}
                    {% endfor %}
                    {% if display_name == blank %}
                      {% assign display_name = calendar_names[event.calname] | default: event.calname %}
                    {% endif %}
                    {% assign show_prefix = true %}
                    {% if hide_prefix_for contains display_name %}
                      {% assign show_prefix = false %}
                    {% endif %}
                    {% assign initial = display_name | strip | slice: 0, 1 | upcase %}
                    <div class="month-event{% if event.all_day %} month-event--all-day bg--gray-70 2bit:bg--gray-65 1bit:bg--black 1bit:text--white{% endif %}">
                      <div class="month-event-title">
                        {% if show_prefix and initial != blank %}<span class="month-event-prefix">[{{ initial }}]</span> {% endif %}{{ event.summary }}
                      </div>
                      {% unless event.all_day %}
                        <span class="month-event-time text--gray-40 1bit:text--black">{{ event.start }}{% if event.end and event.end != event.start %} - {{ event.end }}{% endif %}</span>
                      {% endunless %}
                    </div>
                  {% endif %}
                {% endfor %}
              </div>
            {% endunless %}
          </div>
        {% endfor %}
      {% endif %}

      {% assign next_day = first_week_last | plus: 1 %}
      {% for week in (1..5) %}
        {% if next_day > days_in_month %}{% break %}{% endif %}
        {% assign week_end = next_day | plus: 6 %}
        {% if week_end > days_in_month %}{% assign week_end = days_in_month %}{% endif %}

        {% if week_end >= today_day %}
          {% assign weeks_shown = weeks_shown | plus: 1 %}
          {% for day_num in (next_day..week_end) %}
            {% assign dd = day_num | prepend: '00' | slice: -2, 2 %}
            {% assign day_iso = year | append: '-' | append: month | append: '-' | append: dd %}
            {% assign is_today = false %}
            {% assign is_past = false %}
            {% assign is_weekend = false %}
            {% assign day_wday = day_iso | date: '%w' | plus: 0 %}
            {% if day_iso == today_iso %}{% assign is_today = true %}{% endif %}
            {% if day_iso < today_iso %}{% assign is_past = true %}{% endif %}
            {% if day_wday == 0 or day_wday == 6 %}{% assign is_weekend = true %}{% endif %}
            <div class="month-day{% if is_today %} month-day--today{% endif %}{% if is_weekend %} month-day--weekend bg--gray-75 2bit:bg--gray-70{% endif %}">
              <div class="month-day-num text--gray-50 1bit:text--black"><span class="{% if is_today %}bg--black text--white{% endif %}">{{ day_num }}</span></div>
              {% unless is_past %}
                <div class="month-day-events">
                  {% for event in events %}
                    {% assign ev_start = event.start_full | default: event.date_time | date: '%Y-%m-%d' %}
                    {% assign ev_end = event.end_full | default: event.date_time | date: '%Y-%m-%d' %}
                    {% assign show_event = false %}
                    {% if event.all_day %}
                      {% if ev_end > ev_start %}
                        {% if ev_start <= day_iso and day_iso < ev_end %}{% assign show_event = true %}{% endif %}
                      {% elsif ev_start == day_iso %}
                        {% assign show_event = true %}
                      {% endif %}
                    {% else %}
                      {% if ev_start <= day_iso and ev_end >= day_iso %}{% assign show_event = true %}{% endif %}
                    {% endif %}
                    {% if show_event %}
                      {% assign display_name = '' %}
                      {% for pair in calendar_names %}
                        {% if pair[0] == event.calname %}
                          {% assign display_name = pair[1] %}
                        {% endif %}
                      {% endfor %}
                      {% if display_name == blank %}
                        {% assign display_name = calendar_names[event.calname] | default: event.calname %}
                      {% endif %}
                      {% assign show_prefix = true %}
                      {% if hide_prefix_for contains display_name %}
                        {% assign show_prefix = false %}
                      {% endif %}
                      {% assign initial = display_name | strip | slice: 0, 1 | upcase %}
                      <div class="month-event{% if event.all_day %} month-event--all-day bg--gray-70 2bit:bg--gray-65 1bit:bg--black 1bit:text--white{% endif %}">
                        <div class="month-event-title">
                          {% if show_prefix and initial != blank %}<span class="month-event-prefix">[{{ initial }}]</span> {% endif %}{{ event.summary }}
                        </div>
                        {% unless event.all_day %}
                          <span class="month-event-time text--gray-40 1bit:text--black">{{ event.start }}{% if event.end and event.end != event.start %} - {{ event.end }}{% endif %}</span>
                        {% endunless %}
                      </div>
                    {% endif %}
                  {% endfor %}
                </div>
              {% endunless %}
            </div>
          {% endfor %}
          {% assign cells = week_end | minus: next_day | plus: 1 %}
          {% assign pad = 7 | minus: cells %}
          {% if pad > 0 %}
            {% for i in (1..pad) %}
              {% assign day_num = i %}
              {% assign dd = day_num | prepend: '00' | slice: -2, 2 %}
              {% assign day_iso = next_year | append: '-' | append: next_month | append: '-' | append: dd %}
              {% assign is_weekend = false %}
              {% assign day_wday = day_iso | date: '%w' | plus: 0 %}
              {% if day_wday == 0 or day_wday == 6 %}{% assign is_weekend = true %}{% endif %}
              <div class="month-day month-day--other{% if is_weekend %} month-day--weekend bg--gray-75 2bit:bg--gray-70{% endif %}">
                <div class="month-day-num text--gray-60 1bit:text--black"><span>{{ day_num }}</span></div>
                <div class="month-day-events">
                  {% for event in events %}
                    {% assign ev_start = event.start_full | default: event.date_time | date: '%Y-%m-%d' %}
                    {% assign ev_end = event.end_full | default: event.date_time | date: '%Y-%m-%d' %}
                    {% assign show_event = false %}
                    {% if event.all_day %}
                      {% if ev_end > ev_start %}
                        {% if ev_start <= day_iso and day_iso < ev_end %}{% assign show_event = true %}{% endif %}
                      {% elsif ev_start == day_iso %}
                        {% assign show_event = true %}
                      {% endif %}
                    {% else %}
                      {% if ev_start <= day_iso and ev_end >= day_iso %}{% assign show_event = true %}{% endif %}
                    {% endif %}
                    {% if show_event %}
                      {% assign display_name = '' %}
                      {% for pair in calendar_names %}
                        {% if pair[0] == event.calname %}
                          {% assign display_name = pair[1] %}
                        {% endif %}
                      {% endfor %}
                      {% if display_name == blank %}
                        {% assign display_name = calendar_names[event.calname] | default: event.calname %}
                      {% endif %}
                      {% assign show_prefix = true %}
                      {% if hide_prefix_for contains display_name %}
                        {% assign show_prefix = false %}
                      {% endif %}
                      {% assign initial = display_name | strip | slice: 0, 1 | upcase %}
                      <div class="month-event{% if event.all_day %} month-event--all-day bg--gray-70 2bit:bg--gray-65 1bit:bg--black 1bit:text--white{% endif %}">
                        <div class="month-event-title">
                          {% if show_prefix and initial != blank %}<span class="month-event-prefix">[{{ initial }}]</span> {% endif %}{{ event.summary }}
                        </div>
                        {% unless event.all_day %}
                          <span class="month-event-time text--gray-40 1bit:text--black">{{ event.start }}{% if event.end and event.end != event.start %} - {{ event.end }}{% endif %}</span>
                        {% endunless %}
                      </div>
                    {% endif %}
                  {% endfor %}
                </div>
              </div>
              {% assign next_month_cursor = day_num | plus: 1 %}
            {% endfor %}
          {% endif %}
        {% endif %}
        {% assign next_day = week_end | plus: 1 %}
      {% endfor %}

      {% for extra in (1..4) %}
        {% if weeks_shown >= 4 %}{% break %}{% endif %}
        {% if next_month_cursor > days_in_next_month %}{% break %}{% endif %}
        {% assign weeks_shown = weeks_shown | plus: 1 %}
        {% for col in (0..6) %}
          {% if next_month_cursor > days_in_next_month %}
            <div class="month-day month-day--empty"></div>
          {% else %}
            {% assign day_num = next_month_cursor %}
            {% assign dd = day_num | prepend: '00' | slice: -2, 2 %}
            {% assign day_iso = next_year | append: '-' | append: next_month | append: '-' | append: dd %}
            {% assign is_weekend = false %}
            {% assign day_wday = day_iso | date: '%w' | plus: 0 %}
            {% if day_wday == 0 or day_wday == 6 %}{% assign is_weekend = true %}{% endif %}
            <div class="month-day month-day--other{% if is_weekend %} month-day--weekend bg--gray-75 2bit:bg--gray-70{% endif %}">
              <div class="month-day-num text--gray-60 1bit:text--black"><span>{{ day_num }}</span></div>
              <div class="month-day-events">
                {% for event in events %}
                  {% assign ev_start = event.start_full | default: event.date_time | date: '%Y-%m-%d' %}
                  {% assign ev_end = event.end_full | default: event.date_time | date: '%Y-%m-%d' %}
                  {% assign show_event = false %}
                  {% if event.all_day %}
                    {% if ev_end > ev_start %}
                      {% if ev_start <= day_iso and day_iso < ev_end %}{% assign show_event = true %}{% endif %}
                    {% elsif ev_start == day_iso %}
                      {% assign show_event = true %}
                    {% endif %}
                  {% else %}
                    {% if ev_start <= day_iso and ev_end >= day_iso %}{% assign show_event = true %}{% endif %}
                  {% endif %}
                  {% if show_event %}
                    {% assign display_name = '' %}
                    {% for pair in calendar_names %}
                      {% if pair[0] == event.calname %}
                        {% assign display_name = pair[1] %}
                      {% endif %}
                    {% endfor %}
                    {% if display_name == blank %}
                      {% assign display_name = calendar_names[event.calname] | default: event.calname %}
                    {% endif %}
                    {% assign show_prefix = true %}
                    {% if hide_prefix_for contains display_name %}
                      {% assign show_prefix = false %}
                    {% endif %}
                    {% assign initial = display_name | strip | slice: 0, 1 | upcase %}
                    <div class="month-event{% if event.all_day %} month-event--all-day bg--gray-70 2bit:bg--gray-65 1bit:bg--black 1bit:text--white{% endif %}">
                      <div class="month-event-title">
                        {% if show_prefix and initial != blank %}<span class="month-event-prefix">[{{ initial }}]</span> {% endif %}{{ event.summary }}
                      </div>
                      {% unless event.all_day %}
                        <span class="month-event-time text--gray-40 1bit:text--black">{{ event.start }}{% if event.end and event.end != event.start %} - {{ event.end }}{% endif %}</span>
                      {% endunless %}
                    </div>
                  {% endif %}
                {% endfor %}
              </div>
            </div>
            {% assign next_month_cursor = next_month_cursor | plus: 1 %}
          {% endif %}
        {% endfor %}
      {% endfor %}
    </div>
  </div>
</div>

<div class="title_bar">
  <span class="title">{{ today_label }}</span>
  <span class="instance">Calendar</span>
</div>

